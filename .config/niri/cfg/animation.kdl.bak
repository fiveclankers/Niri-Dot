animations {
    slowdown 1.18

    workspace-switch {
        spring damping-ratio=0.62 stiffness=380 epsilon=0.0001
    }

    window-open {
        duration-ms 420
        curve "cubic-bezier" 0.02 0.92 0.08 1.12

        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float overshoot = sin(p * 3.14159) * 1.08;
                float scale = 0.88 + (0.12 * overshoot);
                vec2 coords = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                float bounce = sin(p * 2.0) * (1.0 - p) * 0.06;
                coords.y += bounce - (1.0 - p) * 0.08;
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                float fade = smoothstep(0.0, 0.18, p);
                float glow = (1.0 - smoothstep(0.6, 1.0, p)) * 0.15;
                return color * fade + vec4(0.5, 0.8, 0.7, 1.0) * glow * fade;
            }
        "
    }

    window-close {
        duration-ms 360
        curve "cubic-bezier" 0.08 0.58 0.12 0.92

        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float squeeze = 1.0 - (0.08 * p * p);
                vec2 coords = (coords_geo.xy - vec2(0.5)) / squeeze + vec2(0.5);
                float pull = p * p * 0.12;
                coords.y += pull;
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                float fade = 1.0 - pow(p, 0.6);
                return color * fade;
            }
        "
    }

    horizontal-view-movement {
        spring damping-ratio=0.58 stiffness=280 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.68 stiffness=360 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.72 stiffness=420 epsilon=0.0001

        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                float p = niri_clamped_progress;
                vec3 coords_tex_prev = niri_geo_to_tex_prev * coords_curr_geo;
                vec4 color_prev = texture2D(niri_tex_prev, coords_tex_prev.st);

                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color_next = texture2D(niri_tex_next, coords_tex_next.st);

                float elastic = sin(p * 3.14159) * 0.03 * (1.0 - p);
                return mix(color_prev, color_next, p + elastic);
            }
        "
    }

    config-notification-open-close {
        spring damping-ratio=0.42 stiffness=600 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.48 stiffness=500 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 520
        curve "ease-out-expo"
    }

    overview-open-close {
        spring damping-ratio=0.56 stiffness=220 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.62 stiffness=320 epsilon=0.001
    }
}
